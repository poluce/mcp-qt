{
    "agents": {
        "agentA": [
            "memory",
            "everything",
            "mcp-apps-map"
        ],
        "agentB": [
            "everything",
            "mcp-apps-map"
        ]
    },
    "logFile": "F:/B_My_Document/GitHub/mcp-qt/examples/multi_server_agent/persistent_test.log",
    "mcpServers": {
        "everything": {
            "args": [
                "-y",
                "@modelcontextprotocol/server-everything"
            ],
            "command": "npx.cmd"
        },
        "fetch": {
            "args": [
                "-m",
                "mcp_server_fetch",
                "--ignore-robots-txt"
            ],
            "command": "python"
        },
        "filesystem": {
            "args": [
                "-y",
                "@modelcontextprotocol/server-filesystem",
                "F:/B_My_Document/GitHub/mcp-cpp-agent"
            ],
            "command": "npx.cmd"
        },
        "mcp-apps-map": {
            "type": "sse",
            "url": "http://localhost:3001/mcp"
        },
        "memory": {
            "args": [
                "-y",
                "@modelcontextprotocol/server-memory"
            ],
            "command": "npx.cmd"
        },
        "mock-search-server": {
            "args": [
                "F:/B_My_Document/GitHub/mcp-cpp-agent/examples/multi_server_agent/mock_search_server.js"
            ],
            "command": "node"
        },
        "playwright": {
            "args": [
                "-y",
                "@playwright/mcp"
            ],
            "command": "npx.cmd"
        },
        "stateless-http-demo": {
            "protocolVersion": "2026-07-28",
            "type": "stateless_http",
            "url": "http://127.0.0.1:8080/mcp"
        }
    }
}
