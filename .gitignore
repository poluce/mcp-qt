# Build directories
build/
bin/
lib/

# WebView2 SDK 头文件位于 third_party/webview2/sdk/build/native/include/，
# 被上面的 build/ 模式误伤（git 无法重新包含被忽略目录内的文件，需逐级放行）。
# 这些头文件是 mcp_qt_apps 构建必需，必须入库。
!third_party/webview2/sdk/build/
!third_party/webview2/sdk/build/native/
!third_party/webview2/sdk/build/native/include/

# IDE configurations
.vscode/
.idea/
*.user
*.suo
*.userossc
*.sln
*.vcxproj
*.filters

# OS temporary files
Thumbs.db
Desktop.ini
.DS_Store
build_sdk
build_*
.playwright*